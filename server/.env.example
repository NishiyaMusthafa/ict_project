PORT=5000
# Example MongoDB Atlas URI (Replace with your actual MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/lostloop?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret_before_deploying
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional Cloudinary Configuration (Leave blank to use elegant fallback badges/illustrations)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
